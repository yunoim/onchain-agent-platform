# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
*.tfvars
!*.example.tfvars

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/
.coverage
htmlcov/

# Terraform (.terraform.lock.hcl IS committed: it pins provider versions and checksums)
.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfplan

# Helm
deploy/helm/**/charts/
*.tgz

# Kubernetes
kubeconfig*
!kubeconfig.example

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Node (in case of tooling)
node_modules/

# Local run logs
*.log

# kubeconfig written by the kind Terraform provider next to the root module
infra/terraform/local/*-config
infra/terraform/local/onchain-agent-config

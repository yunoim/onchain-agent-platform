# Copy to .env for local docker compose. Never commit .env.
# Every value here has a working default for the local stack; the file is optional
# unless you want Etherscan history tools or a hosted model.
# In Kubernetes these become a Secret created by Terraform (see infra/terraform).

# --- Ethereum data sources (ADR-0002) ---
# Public JSON-RPC endpoint for state queries (balance, block, gas, tx by hash).
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
# Optional. Enables address-history tools (tx list, token transfers).
# Free tier key from https://etherscan.io/apis . Leave empty to run without history tools.
ETHERSCAN_API_KEY=

# --- LLM gateway (ADR-0004, ADR-0007) ---
# Key the agent uses to authenticate against LiteLLM (any string; LiteLLM master key).
LITELLM_MASTER_KEY=sk-local-dev-change-me
# Local model server on the host, as seen from containers. Run `ollama serve` and
# `ollama pull qwen3:8b` on the host first.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Optional. Provider keys are only read by the LiteLLM proxy, never by the agent.
# When set, the claude-default / claude-fast aliases become usable.
ANTHROPIC_API_KEY=

# --- Agent ---
# Model alias defined in services/gateway/litellm/config.yaml:
#   local-default (Ollama qwen3:8b, no key needed) | claude-default | claude-fast
LLM_MODEL=local-default
# Set to DEBUG to see the tool-calling loop in container logs.
LOG_LEVEL=INFO
